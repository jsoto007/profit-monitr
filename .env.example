# Copy to .env for local development. On Render these come from render.yaml / the dashboard.
# Never commit real values.

# Postgres connection string. Locally: Postgres.app on :5432 (trust auth).
# Tests use the same server with the database name suffixed "_test".
DATABASE_URL="postgresql://USER@localhost:5432/profit_monitr?schema=public"

# Public origin of the app (canonical URLs, sitemap, links in emails).
# On Render this falls back to RENDER_EXTERNAL_URL, so it is only needed for a custom domain.
APP_URL="http://localhost:3000"

# Display host for tracked links shown in the UI: monitr.link/<venue>/<slug>.
NEXT_PUBLIC_LINK_HOST="monitr.link"

# Protects POST /api/cron/weekly-brief. The endpoint is disabled (503) while this is unset.
# CRON_SECRET="generate-a-long-random-string"

# Accounts are free pilots (no card, nothing charged). In production, sign-up stays
# closed unless this is set (local development ignores it).
# ALLOW_SIGNUPS="1"

# Optional — cookieless page analytics. Nothing loads unless BOTH are set (build-time values).
# SITE is what the script reports for: Plausible wants your hostname, Umami wants its website UUID.
# NEXT_PUBLIC_ANALYTICS_SRC="https://plausible.io/js/script.js"
# NEXT_PUBLIC_ANALYTICS_SITE="yourdomain.com"

# Optional — transactional email through Resend. Without a key, emails are printed to the server log.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Profit Monitr <hello@yourdomain.com>"

# Optional — where "Book a 30-minute session" requests are sent.
# OPS_EMAIL="team@yourdomain.com"
